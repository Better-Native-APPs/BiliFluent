<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="BiliCopilot.UI.Forms.CaptchaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Forms"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <TitleBar x:Name="TitleBar" Title="{ext:Locale Name=CaptchaWindowTitle}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  The challenge itself. Nothing else is ever loaded into this view.  -->
        <WebView2
            x:Name="CaptchaView"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="{ext:Locale Name=CaptchaViewName}"
            IsTabStop="False"
            Loaded="OnCaptchaViewLoadedAsync" />

        <!--  Covers the view until the challenge is on screen, and whenever loading fails.  -->
        <Grid
            x:Name="CoverPanel"
            Grid.Row="1"
            Padding="32,0"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="{ext:Locale Name=CaptchaLoading}"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{ext:Locale Name=CaptchaLoading}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="ErrorPanel"
                MaxWidth="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <ic:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="36"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Symbol="ErrorCircle" />
                <TextBlock
                    x:Name="ErrorTitleBlock"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{ext:Locale Name=CaptchaLoadFailed}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ErrorDescriptionBlock"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RetryButton"
                        MinWidth="104"
                        Click="OnRetryButtonClick"
                        Content="{ext:Locale Name=SignInRetry}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        MinWidth="104"
                        Click="OnCloseButtonClick"
                        Content="{ext:Locale Name=SignInClose}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</winex:WindowEx>
