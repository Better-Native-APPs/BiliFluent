<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="BiliCopilot.UI.Forms.WebSignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Forms"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TitleBar x:Name="TitleBar" Title="{ext:Locale Name=AppName}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Turning the web session into an app authorization takes a moment and can fail.  -->
        <InfoBar
            x:Name="ImportProgressBar"
            Grid.Row="1"
            IsClosable="False"
            Message="{ext:Locale Name=WebSignInFinishing}"
            Severity="Informational">
            <InfoBar.Content>
                <ProgressBar
                    Margin="0,0,0,12"
                    AutomationProperties.Name="{ext:Locale Name=WebSignInFinishing}"
                    IsIndeterminate="True" />
            </InfoBar.Content>
        </InfoBar>
        <InfoBar
            x:Name="ImportErrorBar"
            Title="{ext:Locale Name=WebSignInFailedTitle}"
            Grid.Row="1"
            IsClosable="False"
            Message="{ext:Locale Name=WebSignInFailedDescription}"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button
                    x:Name="ImportRetryButton"
                    Click="OnImportRetryButtonClickAsync"
                    Content="{ext:Locale Name=SignInRetry}" />
            </InfoBar.ActionButton>
        </InfoBar>
        <WebView2
            x:Name="MainView"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Loaded="OnLoadedAsync"
            NavigationCompleted="OnNavigationCompletedAsync" />
    </Grid>
</winex:WindowEx>
