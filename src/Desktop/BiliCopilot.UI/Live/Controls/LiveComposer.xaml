<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Live.Controls.LiveComposer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    IsTabStop="False">

    <!--
        The danmaku box of a live room: the draft and a send button beside it. The row of a room on both
        transport bars hosts it.
        The draft belongs to the room connector; this control edits it and asks for one send per explicit action.
    -->
    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
            x:Name="DraftBox"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            AcceptsReturn="False"
            IsEnabled="False"
            IsSpellCheckEnabled="False"
            KeyDown="OnDraftKeyDown"
            MaxLength="100"
            TextChanged="OnDraftTextChanged"
            TextCompositionEnded="OnCompositionEnded"
            TextCompositionStarted="OnCompositionStarted"
            TextWrapping="NoWrap" />
        <!--  A click sends and leaves the caret in the box, ready for the next line.  -->
        <Button
            x:Name="SendButton"
            Grid.Column="1"
            VerticalAlignment="Center"
            AllowFocusOnInteraction="False"
            Click="OnSendClick"
            IsEnabled="False"
            Style="{StaticResource CircleIconButtonStyle}">
            <Grid>
                <ic:SymbolIcon
                    x:Name="SendIcon"
                    FontSize="14"
                    Symbol="Send" />
                <ProgressRing
                    x:Name="SendingRing"
                    Width="16"
                    Height="16"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
