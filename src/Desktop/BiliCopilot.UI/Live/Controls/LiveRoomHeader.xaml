<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Live.Controls.LiveRoomHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    Height="56"
    IsTabStop="False">

    <!--
        Room header (EmbeddedPlayerView PlayerHeader: 56 / Padding 16,0 / card fill).
        Display only: every value arrives through a property and every action leaves as an event.
        The host owns the divider below the header and decides when the header is shown.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Live/Controls/LiveStatusResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Padding="16,0"
        ColumnSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <!--  Playback dot colour. Idle is the Ellipse's own Fill.  -->
            <VisualStateGroup x:Name="PlaybackStates">
                <VisualState x:Name="PlaybackIdleState" />
                <VisualState x:Name="PlaybackLiveState">
                    <VisualState.Setters>
                        <Setter Target="PlaybackDot.Fill" Value="{ThemeResource LiveStateLiveBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PlaybackWarnState">
                    <VisualState.Setters>
                        <Setter Target="PlaybackDot.Fill" Value="{ThemeResource LiveStateWarnBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PlaybackErrorState">
                    <VisualState.Setters>
                        <Setter Target="PlaybackDot.Fill" Value="{ThemeResource LiveStateErrorBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  The card fill, edge to edge under the padding. A host that paints the header row itself hides it.  -->
        <Border
            x:Name="Backdrop"
            Grid.ColumnSpan="5"
            Margin="-16,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

        <!--  Anchor avatar asks the host to open the user space (app AvatarButtonStyle: scale feedback on hover/press).  -->
        <Button
            x:Name="AnchorButton"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Click="OnAnchorClick"
            CornerRadius="16"
            IsEnabled="False"
            Style="{StaticResource AvatarButtonStyle}">
            <PersonPicture
                x:Name="AnchorPicture"
                Width="32"
                Height="32"
                AutomationProperties.AccessibilityView="Raw"
                IsTabStop="False" />
        </Button>

        <!--  Title: same type as the VOD main header title (Bold, single line, trimmed).  -->
        <TextBlock
            x:Name="TitleText"
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontWeight="Bold"
            MaxLines="1"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <!--  Anchor meta (secondary caption, like the VOD header's right-hand info). Parts collapse while unknown.  -->
        <StackPanel
            x:Name="AnchorMetaRow"
            Grid.Column="2"
            MaxWidth="320"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                x:Name="AnchorNameText"
                MaxWidth="140"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <Border
                x:Name="FollowTag"
                Padding="6,0,6,1"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="FollowText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
            <StackPanel
                x:Name="AudiencePanel"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="Collapsed">
                <ic:SymbolIcon
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Symbol="People" />
                <TextBlock
                    x:Name="AudienceText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </StackPanel>

        <!--  Playback state comes from the player side, not from the room.  -->
        <StackPanel
            Grid.Column="3"
            MaxWidth="200"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Ellipse
                x:Name="PlaybackDot"
                Width="8"
                Height="8"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Fill="{ThemeResource LiveStateIdleBrush}" />
            <TextBlock
                x:Name="PlaybackStatusText"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <!--  Side panel toggle: SideSplitButton visuals (36, transparent, filled 14px glyph, Margin 4,0,0,0).  -->
        <Button
            x:Name="ChatToggle"
            Grid.Column="4"
            Width="36"
            Height="36"
            Margin="4,0,0,0"
            Padding="0"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="OnChatToggleClick">
            <ic:SymbolIcon
                x:Name="ChatToggleIcon"
                FontSize="14"
                IconVariant="Filled"
                Symbol="PanelRightContract" />
        </Button>
    </Grid>
</UserControl>
