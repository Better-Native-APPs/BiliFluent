<?xml version="1.0" encoding="utf-8" ?>
<local:ChatMessageControlBase
    x:Class="BiliCopilot.UI.Controls.Message.ChatMessageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Message"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Command="{x:Bind ViewModel.ShowUserSpaceCommand, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanSendMessage, Mode=OneWay}"
            Style="{StaticResource AvatarButtonStyle}">
            <Grid Width="36" Height="36">
                <SymbolIcon
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Symbol="Mail"
                    Visibility="{x:Bind ViewModel.ShowSystemAvatarFallback, Mode=OneWay}" />
                <controls:BasicCoverImage
                    CornerRadius="18"
                    DecodeWidth="100"
                    Source="{x:Bind ViewModel.Avatar, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowSystemAvatarFallback, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
            </Grid>
        </Button>
        <TextBlock
            x:Name="UserNameBlock"
            Grid.Column="1"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Text="{x:Bind ViewModel.UserName, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap">
            <ToolTipService.ToolTip>
                <ToolTip Content="{x:Bind ViewModel.UserName, Mode=OneWay}" IsEnabled="{x:Bind UserNameBlock.IsTextTrimmed, Mode=OneWay}" />
            </ToolTipService.ToolTip>
        </TextBlock>

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Command="{x:Bind ViewModel.MarkAsReadCommand, Mode=OneWay}"
                Content="{ext:Locale Name=MarkAsRead}"
                Visibility="{x:Bind ViewModel.IsSystemSession, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="{ext:Locale Name=Refresh}"
                Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Symbol="ArrowSync" />
                    <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=Refresh}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:ChatMessageControlBase>
