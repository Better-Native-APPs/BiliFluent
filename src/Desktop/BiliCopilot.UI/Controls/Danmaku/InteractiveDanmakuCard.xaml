<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Danmaku.InteractiveDanmakuCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Danmaku"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Same compact sizes as the other notices floating over the video.  -->
        <Style
            x:Key="CardIconButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style
            x:Key="CardButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4,10,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="CardAccentButtonStyle"
            BasedOn="{StaticResource AccentButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4,10,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="CardSmallButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,3,4,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="CardCaptionStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!--
        One card of the interactive danmaku layer. The surface matches the SponsorBlock notice that can sit
        beside it: in-app acrylic, flyout stroke, 12 radius. Only the section of the card's kind is loaded.
        Every press on the card stops here, so it never reaches the pause / full screen gestures of the player.
        The surface is a separate layer behind the content, so a change of height can stretch it smoothly
        while the content is revealed underneath (see OnCardSizeChanged).
    -->
    <Grid
        x:Name="CardRoot"
        DoubleTapped="OnCardDoubleTapped"
        Holding="OnCardHolding"
        PointerPressed="OnCardPointerHandled"
        PointerReleased="OnCardPointerHandled"
        RightTapped="OnCardRightTapped"
        SizeChanged="OnCardSizeChanged"
        Tapped="OnCardTapped">
        <Border
            x:Name="CardSurface"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="12" />
        <Grid
            x:Name="CardContent"
            Padding="13,9,9,13"
            RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header: who or what this is, the time left, close.  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PersonPicture
                    x:Name="Avatar"
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    IsTabStop="False"
                    Visibility="Collapsed" />
                <Border
                    x:Name="KindBadge"
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="14">
                    <ic:SymbolIcon
                        x:Name="KindIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IconVariant="Filled"
                        Symbol="Megaphone" />
                </Border>
                <TextBlock
                    x:Name="KindLabel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    MaxLines="1"
                    Style="{StaticResource CardCaptionStyle}"
                    TextTrimming="CharacterEllipsis" />
                <!--  Fixed width: the number changes once a second and must not move anything else.  -->
                <TextBlock
                    x:Name="RemainingText"
                    Grid.Column="2"
                    Width="44"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Right" />
                <Button
                    x:Name="CloseButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{ext:Locale Name=CommandDanmakuClose}"
                    Style="{StaticResource CardIconButtonStyle}"
                    ToolTipService.ToolTip="{ext:Locale Name=CommandDanmakuClose}">
                    <ic:SymbolIcon FontSize="12" Symbol="Dismiss" />
                </Button>
            </Grid>

            <StackPanel
                Grid.Row="1"
                Margin="0,0,4,0"
                Spacing="8">
                <TextBlock
                    x:Name="TitleText"
                    MaxLines="3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />

                <!--  Related video.  -->
                <Button
                    x:Name="LinkSection"
                    x:Load="False"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{ext:Locale Name=CommandDanmakuOpenVideo}"
                    Style="{StaticResource CardAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            IconVariant="Filled"
                            Symbol="Play" />
                        <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=CommandDanmakuOpenVideo}" />
                    </StackPanel>
                </Button>

                <!--  Follow and like / coin / triple.  -->
                <StackPanel
                    x:Name="AttentionSection"
                    x:Load="False"
                    Spacing="6">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="FollowButton"
                            Content="{ext:Locale Name=CommandDanmakuFollow}"
                            Style="{StaticResource CardAccentButtonStyle}" />
                        <StackPanel
                            x:Name="FollowedLabel"
                            MinHeight="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="Collapsed">
                            <ic:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                IconVariant="Filled"
                                Symbol="CheckmarkCircle" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardCaptionStyle}"
                                Text="{ext:Locale Name=CommandDanmakuFollowed}" />
                        </StackPanel>
                        <Button
                            x:Name="TripleButton"
                            Grid.Column="1"
                            Content="{ext:Locale Name=CommandDanmakuTriple}"
                            Style="{StaticResource CardButtonStyle}"
                            ToolTipService.ToolTip="{ext:Locale Name=CommandDanmakuTripleTip}" />
                    </Grid>
                    <Grid x:Name="SupportRow" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="LikeButton"
                            Style="{StaticResource CardSmallButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ic:SymbolIcon
                                    x:Name="LikeIcon"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Symbol="ThumbLike" />
                                <TextBlock
                                    x:Name="LikeText"
                                    VerticalAlignment="Center"
                                    FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CoinOneButton"
                            Grid.Column="1"
                            Content="{ext:Locale Name=CommandDanmakuCoinOne}"
                            Style="{StaticResource CardSmallButtonStyle}" />
                        <Button
                            x:Name="CoinTwoButton"
                            Grid.Column="2"
                            Content="{ext:Locale Name=CommandDanmakuCoinTwo}"
                            Style="{StaticResource CardSmallButtonStyle}" />
                        <StackPanel
                            x:Name="CoinedLabel"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="Collapsed">
                            <ic:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                IconVariant="Filled"
                                Symbol="CheckmarkCircle" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardCaptionStyle}"
                                Text="{ext:Locale Name=CommandDanmakuCoined}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!--  Poll: results only.  -->
                <StackPanel
                    x:Name="VoteSection"
                    x:Load="False"
                    Spacing="2">
                    <ScrollViewer
                        x:Name="VoteScroller"
                        MaxHeight="184"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        IsTabStop="True"
                        UseSystemFocusVisuals="True"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="VoteList" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CommandDanmakuVoteRow">
                                    <Grid
                                        Margin="0,0,0,8"
                                        ColumnSpacing="6"
                                        RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ic:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            IconVariant="Filled"
                                            Symbol="CheckmarkCircle"
                                            ToolTipService.ToolTip="{ext:Locale Name=CommandDanmakuVoteSelected}"
                                            Visibility="{x:Bind IsSelected}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            MaxLines="2"
                                            Text="{x:Bind Text}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Style="{StaticResource CardCaptionStyle}"
                                            Text="{x:Bind Stats}" />
                                        <ProgressBar
                                            Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            AutomationProperties.Name="{x:Bind AutomationName}"
                                            Maximum="100"
                                            Value="{x:Bind Percent}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="VoteSummary"
                        Style="{StaticResource CardCaptionStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Rating: pick the stars, then submit.  -->
                <StackPanel
                    x:Name="GradeSection"
                    x:Load="False"
                    Spacing="4">
                    <RatingControl
                        x:Name="GradeRating"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{ext:Locale Name=CommandDanmakuKindGrade}"
                        IsClearEnabled="True"
                        MaxRating="5"
                        ValueChanged="OnGradeValueChanged" />
                    <TextBlock
                        x:Name="GradeSummary"
                        Style="{StaticResource CardCaptionStyle}"
                        TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            x:Name="GradeStatus"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                            <ic:SymbolIcon
                                x:Name="GradeDoneIcon"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                IconVariant="Filled"
                                Symbol="CheckmarkCircle" />
                            <ic:SymbolIcon
                                x:Name="GradeFailedIcon"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                IconVariant="Filled"
                                Symbol="Warning" />
                            <TextBlock
                                x:Name="GradeStatusText"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="GradeSubmitButton"
                            Grid.Column="1"
                            MinWidth="72"
                            VerticalAlignment="Center"
                            Click="OnGradeSubmitClick"
                            Style="{StaticResource CardAccentButtonStyle}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
