<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.AboutSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  Same layout as the About section in Windows Settings: one collapsed expander, notices inside.  -->
    <community:SettingsExpander x:Name="AboutCard" Header="{ext:Locale Name=AppName}">
        <community:SettingsExpander.HeaderIcon>
            <ImageIcon Source="ms-appx:///Assets/StoreLogo.png" />
        </community:SettingsExpander.HeaderIcon>
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True">
            <Run Text="{ext:Locale Name=Version}" />
            <Run Text="{x:Bind ViewModel.PackageVersion, Mode=OneWay}" />
        </TextBlock>
        <community:SettingsExpander.Items>
            <community:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{ext:Locale Name=AboutDerivativeNotice}"
                    TextWrapping="Wrap" />
            </community:SettingsCard>
            <community:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                    <HyperlinkButton Content="{ext:Locale Name=AboutUpstreamRepository}" NavigateUri="https://github.com/Richasy/Bili.Copilot" />
                    <HyperlinkButton Content="{ext:Locale Name=AboutSourceRepository}" NavigateUri="https://github.com/Better-Native-APPs/BiliFluent" />
                </StackPanel>
            </community:SettingsCard>
        </community:SettingsExpander.Items>
    </community:SettingsExpander>
</local:SettingsPageControlBase>
