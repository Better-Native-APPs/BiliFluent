<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.RecommendationFeedSettingSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:BiliCopilot.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Richasy.BiliKernel.Models.Media"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:RecommendationFeedSourceConverter x:Key="RecommendationFeedSourceConverter" />
    </UserControl.Resources>

    <community:SettingsCard Description="{ext:Locale Name=HomeRecommendationFeedSourceDescription}" Header="{ext:Locale Name=HomeRecommendationFeedSource}">
        <community:SettingsCard.HeaderIcon>
            <ic:SymbolIcon Symbol="Balloon" />
        </community:SettingsCard.HeaderIcon>
        <ComboBox
            MinWidth="120"
            ItemsSource="{x:Bind ViewModel.HomeRecommendationFeedSourceCollection, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.HomeRecommendationFeedSource, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="media:RecommendationFeedSource">
                    <TextBlock Text="{x:Bind Converter={StaticResource RecommendationFeedSourceConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </community:SettingsCard>
</local:SettingsPageControlBase>
