<?xml version="1.0" encoding="utf-8" ?>
<local:ViewLaterPageControlBase
    x:Class="BiliCopilot.UI.Controls.ViewLater.ViewLaterBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.ViewLater"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <controls:IncrementVerticalScrollControl x:Name="View" ScrollPadding="16,0" LoadMoreCommand="{x:Bind ViewModel.LoadVideosCommand, Mode=OneWay}" RefreshCommand="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}">
            <controls:IncrementVerticalScrollControl.Element>
                <Grid Margin="0,12">
                    <ItemsRepeater
                        x:Name="VideoRepeater"
                        ItemsSource="{x:Bind ViewModel.Videos}"
                        Layout="{StaticResource VideoLayout}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="items:VideoItemViewModel">
                                <components:VideoCardControl Style="{StaticResource ViewLaterVideoCardStyle}" ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </controls:IncrementVerticalScrollControl.Element>

        </controls:IncrementVerticalScrollControl>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="Segoe UI Emoji"
                FontSize="40"
                Glyph="&#x1F92A;" />
            <TextBlock
                MaxWidth="240"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalTextAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{ext:Locale Name=NoViewLaterVideos}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Margin="20"
            Padding="20,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                MinWidth="20"
                MinHeight="20"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=LoadingAndWait}" />
        </StackPanel>
    </Grid>
</local:ViewLaterPageControlBase>
