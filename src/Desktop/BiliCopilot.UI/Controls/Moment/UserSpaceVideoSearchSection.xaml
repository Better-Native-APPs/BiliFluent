<?xml version="1.0" encoding="utf-8" ?>
<local:UserSpacePageControlBase
    x:Class="BiliCopilot.UI.Controls.Moment.UserSpaceVideoSearchSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Moment"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ItemsView
            x:Name="View"
            Padding="16,12"
            ItemsSource="{x:Bind ViewModel.SearchVideos, Mode=OneWay}"
            Layout="{StaticResource VideoLayout}"
            SelectionMode="None">
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="items:VideoItemViewModel">
                    <ItemContainer AutomationProperties.Name="{x:Bind Title}" IsTabStop="False">
                        <components:VideoCardControl Style="{StaticResource SearchVideoCardStyle}" ViewModel="{x:Bind}" />
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
        </ItemsView>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsSearchEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="Segoe UI Emoji"
                FontSize="40"
                Glyph="&#x1F39E;" />
            <TextBlock
                MaxWidth="240"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalTextAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{ext:Locale Name=NoSpecificData}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Margin="20"
            Padding="20,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                MinWidth="20"
                MinHeight="20"
                IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=LoadingAndWait}" />
        </StackPanel>
    </Grid>
</local:UserSpacePageControlBase>
