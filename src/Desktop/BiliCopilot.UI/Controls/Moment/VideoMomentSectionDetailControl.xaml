<?xml version="1.0" encoding="utf-8" ?>
<local:VideoMomentSectionDetailControlBase
    x:Class="BiliCopilot.UI.Controls.Moment.VideoMomentSectionDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Moment"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <controls:IncrementVerticalScrollControl x:Name="View" ScrollPadding="16,0" LoadMoreCommand="{x:Bind ViewModel.LoadItemsCommand, Mode=OneWay}" RefreshCommand="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}">
            <controls:IncrementVerticalScrollControl.Element>
                <Grid Margin="0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ItemsRepeater
                        x:Name="MomentRepeater"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        Layout="{StaticResource MomentLayout}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="items:MomentItemViewModel">
                                <components:MomentCardControl Style="{StaticResource VideoMomentCardStyle}" ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <!--  追加页脚：失败时可显式重试；到底时安静提示  -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                        <StackPanel
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind controls:IncrementVerticalScrollControl.AppendErrorFooterVisibility(ViewModel.HasAppendError, ViewModel.IsAppending), Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{ext:Locale Name=LoadMoreFailed}" />
                            <HyperlinkButton
                                Padding="4,2"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.RetryAppendCommand, Mode=OneWay}"
                                Content="{ext:Locale Name=Retry}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,12,0,0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{ext:Locale Name=NoMoreContent}"
                            Visibility="{x:Bind controls:IncrementVerticalScrollControl.ExhaustedFooterVisibility(ViewModel.IsPrefetchExhausted, ViewModel.HasAppendError, ViewModel.IsAppending, ViewModel.Items.Count), Mode=OneWay}" />
                    </Grid>
                </Grid>
            </controls:IncrementVerticalScrollControl.Element>
        </controls:IncrementVerticalScrollControl>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="Segoe UI Emoji"
                FontSize="40"
                Glyph="&#x1F440;" />
            <TextBlock
                MaxWidth="240"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalTextAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{ext:Locale Name=NoSpecificData}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Margin="20"
            Padding="20,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                MinWidth="20"
                MinHeight="20"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=LoadingAndWait}" />
        </StackPanel>
    </Grid>
</local:VideoMomentSectionDetailControlBase>
