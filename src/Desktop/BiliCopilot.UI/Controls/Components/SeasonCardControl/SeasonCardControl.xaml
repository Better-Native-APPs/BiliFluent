<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Components">

    <Style BasedOn="{StaticResource TimelineSeasonCardStyle}" TargetType="local:SeasonCardControl" />
    <Style x:Key="TimelineSeasonCardStyle" TargetType="local:SeasonCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SeasonCardControl">
                    <Button x:Name="RootCard" Style="{StaticResource ContentCardButtonStyle}">
                        <local:TimelineSeasonPresenter ViewModel="{TemplateBinding ViewModel}" />
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IndexSeasonCardStyle" TargetType="local:SeasonCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SeasonCardControl">
                    <Button x:Name="RootCard" Style="{StaticResource ContentCardButtonStyle}">
                        <local:IndexSeasonPresenter ViewModel="{TemplateBinding ViewModel}" />
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FavoriteSeasonCardStyle" TargetType="local:SeasonCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SeasonCardControl">
                    <Button x:Name="RootCard" Style="{StaticResource ContentCardButtonStyle}">
                        <local:FavoriteSeasonPresenter ViewModel="{TemplateBinding ViewModel}" />
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlayerSeasonCardStyle" TargetType="local:SeasonCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SeasonCardControl">
                    <Grid>
                        <Button
                            x:Name="RootCard"
                            AutomationProperties.ItemStatus="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.IsSelected, Converter={StaticResource SelectedItemStatusConverter}}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            Style="{StaticResource ContentCardButtonStyle}">
                            <local:PlayerSeasonPresenter ViewModel="{TemplateBinding ViewModel}" />
                        </Button>
                        <Border
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
