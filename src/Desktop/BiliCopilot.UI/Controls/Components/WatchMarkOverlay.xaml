<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Components.WatchMarkOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    IsHitTestVisible="False"
    Visibility="Collapsed"
    mc:Ignorable="d">

    <!--
        Laid over the video cover. Both labels share the shape and the 24px height of the duration badge, so the two read as a pair.
        Partly watched is dark acrylic over the cover with white text. Finished is the accent fill with the on-accent text, the same pairing as an accent button,
        so the two states differ in color and not only in icon.
        Nothing is created until a card actually has a mark, so unwatched cards pay nothing for it. The brushes live on the deferred root for the same reason.
    -->
    <Grid
        x:Name="Root"
        x:Load="False"
        CornerRadius="{StaticResource ControlCornerRadius}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!--
                        The glass sits on the cover, not on the card, so it is dark in both app themes.
                        The high luminosity opacity keeps white text readable on a white cover. The fallback is used when the system turns transparency off.
                    -->
                    <ResourceDictionary x:Key="Default">
                        <media:AcrylicBrush
                            x:Key="WatchMarkGlassBrush"
                            FallbackColor="#E0202020"
                            TintColor="#202020"
                            TintLuminosityOpacity="0.85"
                            TintOpacity="0.6" />
                        <SolidColorBrush x:Key="WatchMarkGlassStrokeBrush" Opacity="0.16" Color="White" />
                        <SolidColorBrush x:Key="WatchMarkGlassTextBrush" Color="White" />
                        <SolidColorBrush x:Key="WatchMarkGlassIconBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                        <SolidColorBrush x:Key="WatchMarkAccentStrokeBrush" Opacity="0.28" Color="Black" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="WatchMarkGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="WatchMarkGlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="WatchMarkGlassTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="WatchMarkGlassIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="WatchMarkAccentStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <!--  Finished: accent fill with on-accent text. The thin dark outline keeps it apart from a cover of a similar color.  -->
        <Border
            x:Name="FinishedBadge"
            MinHeight="24"
            Padding="6,1,8,1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            BorderBrush="{ThemeResource WatchMarkAccentStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <ic:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    IconVariant="Filled"
                    Symbol="CheckmarkCircle" />
                <TextBlock
                    x:Name="FinishedLabel"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <!--  Partly watched: dark acrylic with white text and the accent icon, the same tone as the bar below.  -->
        <Border
            x:Name="PartialBadge"
            MinHeight="24"
            Padding="6,1,8,1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource WatchMarkGlassBrush}"
            BorderBrush="{ThemeResource WatchMarkGlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <ic:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource WatchMarkGlassIconBrush}"
                    IconVariant="Filled"
                    Symbol="History" />
                <TextBlock
                    x:Name="PartialLabel"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource WatchMarkGlassTextBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <Grid
            x:Name="BarTrack"
            Height="5"
            VerticalAlignment="Bottom">
            <Grid.Background>
                <SolidColorBrush Opacity="0.7" Color="Black" />
            </Grid.Background>
            <!--
                The card already reports the progress as its ItemStatus, so the bar stays out of the accessibility tree.
                The bar is as thick as its MinHeight. Square ends, because the cover corner already rounds the left one.
            -->
            <ProgressBar
                x:Name="Bar"
                MinHeight="5"
                AutomationProperties.AccessibilityView="Raw"
                Background="Transparent"
                CornerRadius="0"
                Maximum="1">
                <ProgressBar.Foreground>
                    <SolidColorBrush Color="{ThemeResource SystemAccentColorLight2}" />
                </ProgressBar.Foreground>
            </ProgressBar>
        </Grid>
    </Grid>
</UserControl>
