<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Components">
    <Style x:Key="MomentEpisodeCardStyle" TargetType="local:EpisodeCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:EpisodeCardControl">
                    <local:MomentEpisodePresenter ViewModel="{TemplateBinding ViewModel}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayerEpisodeCardStyle" TargetType="local:EpisodeCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:EpisodeCardControl">
                    <Grid>
                        <Button
                            x:Name="RootCard"
                            AutomationProperties.ItemStatus="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.IsSelected, Converter={StaticResource SelectedItemStatusConverter}}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            Style="{StaticResource ContentCardButtonStyle}">
                            <local:PlayerEpisodePresenter ViewModel="{TemplateBinding ViewModel}" />
                        </Button>
                        <Border
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
