<?xml version="1.0" encoding="utf-8" ?>
<core:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.StoreIsland.IslandDanmakuBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BiliCopilot.UI.Controls.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:danmaku="using:BiliCopilot.UI.Controls.Danmaku"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:live="using:BiliCopilot.UI.Live.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:store="using:BiliCopilot.UI.Controls.Player.StoreIsland"
    mc:Ignorable="d">

    <core:PlayerControlBase.Resources>
        <ResourceDictionary>
            <!--  源 PlayerResources.xaml 的 TransportButtonFlyoutPresenterStyle（原值 12,10）局部化  -->
            <Style
                x:Key="TransportButtonFlyoutPresenterStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="12,10" />
            </Style>
        </ResourceDictionary>
    </core:PlayerControlBase.Resources>

    <!--  Store 源 Controls/Danmaku/DanmakuBox.xaml：列间距 8、两列 Auto/*，开关/显示设置/输入框/发送设置原样保留  -->
    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <ToggleButton
                x:Name="DanmakuToggleButton"
                Width="36"
                Height="36"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="{ext:Locale Name=DanmakuSwitch}"
                Content="弹"
                CornerRadius="18"
                FontSize="12"
                FontWeight="Black"
                IsChecked="{x:Bind RenderViewModel.IsShowDanmaku, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.IsDanmakuLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                ToolTipService.ToolTip="{ext:Locale Name=DanmakuSwitch}" />
            <!--  The display settings shape the danmaku of an on-demand media.  -->
            <Button
                x:Name="DanmakuOptionButton"
                AutomationProperties.Name="{ext:Locale Name=DanmakuDisplaySettings}"
                IsEnabled="{x:Bind ViewModel.IsDanmakuLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                Style="{StaticResource CircleIconButtonStyle}"
                ToolTipService.ToolTip="{ext:Locale Name=DanmakuDisplaySettings}"
                Visibility="{x:Bind core:PlayerOverlay.GetCapabilityVisibility(ViewModel.CanLoadOnDemandDanmaku, ViewModel.HasAdmittedMedia), Mode=OneWay}">
                <ic:SymbolIcon FontSize="14" Symbol="ContentSettings" />
                <Button.Flyout>
                    <!--  与全屏弹幕设置共用同一固定宽度面板；弹出层不受视频区域边界约束  -->
                    <Flyout
                        FlyoutPresenterStyle="{StaticResource TransportButtonFlyoutPresenterStyle}"
                        Opened="OnDisplayFlyoutOpened"
                        ShouldConstrainToRootBounds="False">
                        <danmaku:DanmakuDisplayOptions IsCommandDanmakuSwitchVisible="{x:Bind core:PlayerOverlay.IsCapabilityShown(ViewModel.CanUseInteractiveDanmaku, ViewModel.HasAdmittedMedia), Mode=OneWay}" ViewModel="{x:Bind RenderViewModel, Mode=OneWay}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
        <AutoSuggestBox
            x:Name="DanmakuInputBox"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            PlaceholderText="{ext:Locale Name=DanmakuPlaceholder}"
            QuerySubmitted="OnDanmakuInputBoxSubmittedAsync"
            TextChanged="OnDraftChanged"
            Visibility="{x:Bind core:PlayerOverlay.GetCapabilityVisibility(ViewModel.CanSendOnDemandDanmaku, ViewModel.HasAdmittedMedia), Mode=OneWay}">
            <AutoSuggestBox.TextBoxStyle>
                <Style BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}" TargetType="TextBox">
                    <Setter Property="Padding" Value="36,4,8,4" />
                </Style>
            </AutoSuggestBox.TextBoxStyle>
        </AutoSuggestBox>
        <Button
            Grid.Column="1"
            Width="32"
            Height="32"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            AutomationProperties.Name="{ext:Locale Name=DanmakuSendSettings}"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="{ext:Locale Name=DanmakuSendSettings}"
            Visibility="{x:Bind core:PlayerOverlay.GetCapabilityVisibility(ViewModel.CanSendOnDemandDanmaku, ViewModel.HasAdmittedMedia), Mode=OneWay}">
            <ic:SymbolIcon FontSize="12" Symbol="Options" />
            <Button.Flyout>
                <Flyout
                    FlyoutPresenterStyle="{StaticResource TransportButtonFlyoutPresenterStyle}"
                    Opened="OnSendOptionsFlyoutOpened">
                    <store:IslandDanmakuSendOptions x:Name="SendOptions" ViewModel="{x:Bind ViewModel.DanmakuSend, Mode=OneWay}" />
                </Flyout>
            </Button.Flyout>
        </Button>
        <!--
            A live room sends through its own pipeline: the same box in the same place, created only for a room.
            The send settings of the on-demand box do not apply to it.
        -->
        <live:LiveComposer
            x:Name="RoomComposer"
            Grid.Column="1"
            x:Load="{x:Bind ViewModel.HasRoomChat, Mode=OneWay}"
            Connector="{x:Bind ViewModel.LiveConnector, Mode=OneWay}"
            IsActive="{x:Bind IsActive, Mode=OneWay}"
            Noticed="OnRoomComposerNoticed" />
    </Grid>
</core:PlayerControlBase>
