<?xml version="1.0" encoding="utf-8" ?>
<local:UgcFavoriteControlBase
    x:Class="BiliCopilot.UI.Controls.Favorites.UgcFavoriteSideItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BiliCopilot.UI.Controls.Favorites"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Height="52" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <controls:BasicCoverImage
            Width="40"
            Height="40"
            VerticalAlignment="Center"
            CornerRadius="20"
            DecodeWidth="100"
            Source="{x:Bind ViewModel.Cover, Mode=OneWay}" />
        <TextBlock
            x:Name="TitleBlock"
            Grid.Column="1"
            VerticalAlignment="Center"
            Text="{x:Bind ViewModel.Data.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap">
            <ToolTipService.ToolTip>
                <ToolTip Content="{x:Bind ViewModel.Data.Title, Mode=OneWay}" IsEnabled="{x:Bind TitleBlock.IsTextTrimmed, Mode=OneWay}" />
            </ToolTipService.ToolTip>
        </TextBlock>
    </Grid>
</local:UgcFavoriteControlBase>
