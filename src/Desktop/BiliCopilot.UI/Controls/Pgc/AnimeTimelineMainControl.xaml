<?xml version="1.0" encoding="utf-8" ?>
<local:AnimeTimelineControlBase
    x:Class="BiliCopilot.UI.Controls.Pgc.AnimeTimelineMainControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Pgc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer
            x:Name="View"
            Padding="16,0"
            Style="{StaticResource PageScrollViewerStyle}">
            <Grid Margin="0,12">
                <ItemsRepeater
                    x:Name="SeasonRepeater"
                    ItemsSource="{x:Bind ViewModel.SelectedTimeline.Items, Mode=OneWay}"
                    Layout="{StaticResource PgcLayout}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:SeasonItemViewModel">
                            <components:SeasonCardControl Style="{StaticResource TimelineSeasonCardStyle}" ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.SelectedTimeline.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="Segoe UI Emoji"
                FontSize="40"
                Glyph="&#x1F92A;" />
            <TextBlock
                MaxWidth="240"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalTextAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{ext:Locale Name=TimelineHasNoVideo}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Margin="20"
            Padding="20,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsTimelineLoading, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                MinWidth="20"
                MinHeight="20"
                IsActive="{x:Bind ViewModel.IsTimelineLoading, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=LoadingAndWait}" />
        </StackPanel>
    </Grid>
</local:AnimeTimelineControlBase>
