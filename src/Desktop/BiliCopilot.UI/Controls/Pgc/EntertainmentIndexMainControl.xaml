<?xml version="1.0" encoding="utf-8" ?>
<local:EntertainmentIndexControlBase
    x:Class="BiliCopilot.UI.Controls.Pgc.EntertainmentIndexMainControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Pgc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    mc:Ignorable="d">

    <Grid>
        <controls:IncrementVerticalScrollControl x:Name="View" ScrollPadding="16,0" LoadMoreCommand="{x:Bind ViewModel.RequestIndexCommand, Mode=OneWay}">
            <controls:IncrementVerticalScrollControl.Element>
                <Grid Margin="0,12">
                    <repeater:AppRepeater
                        x:Name="SeasonRepeater"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        Layout="{StaticResource PgcLayout}">
                        <repeater:AppRepeater.ItemTemplate>
                            <DataTemplate x:DataType="items:SeasonItemViewModel">
                                <components:SeasonCardControl Style="{StaticResource IndexSeasonCardStyle}" ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </repeater:AppRepeater.ItemTemplate>
                    </repeater:AppRepeater>
                </Grid>
            </controls:IncrementVerticalScrollControl.Element>
        </controls:IncrementVerticalScrollControl>
        <StackPanel
            Margin="20"
            Padding="20,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsSeasonLoading, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                MinWidth="20"
                MinHeight="20"
                IsActive="{x:Bind ViewModel.IsSeasonLoading, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=LoadingAndWait}" />
        </StackPanel>
    </Grid>
</local:EntertainmentIndexControlBase>
