<?xml version="1.0" encoding="utf-8" ?>
<local:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Core.LiveQualityButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:PlayerControlBase.Resources>
        <ResourceDictionary>
            <Style
                x:Key="TransportButtonFlyoutPresenterStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="12,10" />
            </Style>
        </ResourceDictionary>
    </local:PlayerControlBase.Resources>

    <!--
        The quality of a live room on a transport bar: the same menu as the on-demand quality button (a caption
        over a 220px list of card rows, the row that plays selected). There is no automatic entry. A media without
        live tiers shows nothing and takes no room.
    -->
    <Button
        x:Name="EntryButton"
        VerticalAlignment="Center"
        Visibility="Collapsed">
        <ic:SymbolIcon FontSize="14" Symbol="Hd" />
        <Button.Flyout>
            <Flyout
                x:Name="QualityFlyout"
                FlyoutPresenterStyle="{StaticResource TransportButtonFlyoutPresenterStyle}"
                Opened="OnFlyoutOpened"
                Placement="Top"
                ShouldConstrainToRootBounds="False">
                <StackPanel Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{ext:Locale Name=Quality}" />
                    <ItemsView
                        x:Name="QualityView"
                        Width="220"
                        AutomationProperties.Name="{ext:Locale Name=Quality}"
                        IsItemInvokedEnabled="True"
                        ItemInvoked="OnQualityItemInvoked"
                        SelectionChanged="OnQualitySelectionChanged"
                        SelectionMode="Single">
                        <ItemsView.ItemTemplate>
                            <DataTemplate x:DataType="items:SourceItemViewModel">
                                <!--  The card fill sits on the container; the transparent Grid keeps the whole row tappable.  -->
                                <ItemContainer
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Style="{StaticResource AppItemContainerStyle}">
                                    <Grid
                                        MinHeight="40"
                                        Padding="12,0"
                                        Background="Transparent"
                                        Tag="{x:Bind}"
                                        Tapped="OnQualityItemTapped">
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneWay}" />
                                    </Grid>
                                </ItemContainer>
                            </DataTemplate>
                        </ItemsView.ItemTemplate>
                        <ItemsView.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsView.Layout>
                    </ItemsView>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</local:PlayerControlBase>
