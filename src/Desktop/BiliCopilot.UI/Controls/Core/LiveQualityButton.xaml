<?xml version="1.0" encoding="utf-8" ?>
<local:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Core.LiveQualityButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:PlayerControlBase.Resources>
        <ResourceDictionary>
            <!--  The list runs edge to edge inside the flyout; the rows carry their own padding.  -->
            <Style
                x:Key="QualityFlyoutPresenterStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style
                x:Key="QualityItemStyle"
                BasedOn="{StaticResource DefaultListViewItemStyle}"
                TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="40" />
            </Style>
        </ResourceDictionary>
    </local:PlayerControlBase.Resources>

    <!--
        The quality of a live room on a transport bar. A click lists the tiers the room offers, with the one that
        plays marked; there is no automatic entry. While a tier is being switched the icon gives way to a ring.
        A media without live tiers shows nothing and takes no room.
    -->
    <Button
        x:Name="EntryButton"
        VerticalAlignment="Center"
        Visibility="Collapsed">
        <Grid>
            <ic:SymbolIcon
                x:Name="EntryIcon"
                FontSize="14"
                Symbol="Hd" />
            <ProgressRing
                x:Name="SwitchingRing"
                Width="16"
                Height="16"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>
        <Button.Flyout>
            <Flyout
                x:Name="QualityFlyout"
                FlyoutPresenterStyle="{StaticResource QualityFlyoutPresenterStyle}"
                Opened="OnFlyoutOpened"
                Opening="OnFlyoutOpening"
                Placement="Top"
                ShouldConstrainToRootBounds="False">
                <Grid Width="240">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="16,12,16,8"
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{ext:Locale Name=Quality}" />
                    <!--
                        No selection: the row of the tier that plays is marked by the item itself, so moving the
                        keyboard focus through the list never moves the mark. Click, Enter and Space switch.
                    -->
                    <ListView
                        x:Name="QualityList"
                        Grid.Row="1"
                        MaxHeight="360"
                        Padding="0,0,0,6"
                        AutomationProperties.Name="{ext:Locale Name=Quality}"
                        ContainerContentChanging="OnQualityContainerContentChanging"
                        IsItemClickEnabled="True"
                        ItemClick="OnQualityItemClick"
                        ItemContainerStyle="{StaticResource QualityItemStyle}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="items:SourceItemViewModel">
                                <!--  Inset like the hover fill of the row, so the mark of the current tier and the hover fill line up.  -->
                                <Grid Margin="4,2">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                    <Grid Padding="0,6,12,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="1.5"
                                            Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontWeight="{x:Bind local:LiveQualityButton.GetNameWeight(IsSelected), Mode=OneWay}"
                                            MaxLines="1"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <!--  Two tiers of one name differ by this tag, when the name itself does not say it.  -->
                                        <Border
                                            Grid.Column="2"
                                            Style="{StaticResource TagBorderStyle}"
                                            Visibility="{x:Bind local:LiveQualityButton.GetHdrTagVisibility(Data)}">
                                            <TextBlock Style="{StaticResource TagTextStyle}" Text="HDR" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</local:PlayerControlBase>
