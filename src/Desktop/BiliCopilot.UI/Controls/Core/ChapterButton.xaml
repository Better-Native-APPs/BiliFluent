<?xml version="1.0" encoding="utf-8" ?>
<local:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Core.ChapterButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:PlayerControlBase.Resources>
        <ResourceDictionary>
            <!--  The list runs edge to edge inside the flyout; the rows carry their own padding.  -->
            <Style
                x:Key="ChapterFlyoutPresenterStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style
                x:Key="ChapterItemStyle"
                BasedOn="{StaticResource DefaultListViewItemStyle}"
                TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="44" />
            </Style>
        </ResourceDictionary>
    </local:PlayerControlBase.Resources>

    <!--
        The current chapter on a transport bar: an icon and the chapter title, trimmed when long.
        A click opens the chapter list. A media without chapters shows nothing and takes no room.
    -->
    <Button
        x:Name="EntryButton"
        VerticalAlignment="Center"
        Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon
                VerticalAlignment="Center"
                FontSize="14"
                Symbol="TextBulletList" />
            <TextBlock
                x:Name="TitleBlock"
                MaxWidth="120"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                MaxLines="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>
        <Button.Flyout>
            <Flyout
                x:Name="ChapterFlyout"
                FlyoutPresenterStyle="{StaticResource ChapterFlyoutPresenterStyle}"
                Opened="OnFlyoutOpened"
                Opening="OnFlyoutOpening"
                Placement="Top"
                ShouldConstrainToRootBounds="False">
                <Grid Width="320">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="16,12,16,8"
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{ext:Locale Name=Chapters}" />
                    <!--
                        No selection: the row of the chapter that plays is marked by the item itself, so moving
                        the keyboard focus through the list never moves the mark. Click, Enter and Space jump.
                    -->
                    <ListView
                        x:Name="ChapterList"
                        Grid.Row="1"
                        MaxHeight="360"
                        Padding="0,0,0,6"
                        AutomationProperties.Name="{ext:Locale Name=Chapters}"
                        ContainerContentChanging="OnChapterContainerContentChanging"
                        IsItemClickEnabled="True"
                        ItemClick="OnChapterItemClick"
                        ItemContainerStyle="{StaticResource ChapterItemStyle}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="items:ChapterItemViewModel">
                                <!--  Inset like the hover fill of the row, so the mark of the current chapter and the hover fill line up.  -->
                                <Grid Margin="4,2">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Visibility="{x:Bind IsPlaying, Mode=OneWay}" />
                                    <Grid Padding="0,6,12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="1.5"
                                            Visibility="{x:Bind IsPlaying, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            MinWidth="18"
                                            Margin="8,0,10,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalTextAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind local:ChapterButton.GetIndexText(Index)}" />
                                        <!--  The chapter picture, when the chapter has one. Without it the title follows the number.  -->
                                        <controls:BasicCoverImage
                                            Grid.Column="2"
                                            Width="64"
                                            Height="36"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="4"
                                            DecodeWidth="128"
                                            Source="{x:Bind local:ChapterButton.GetImage(ImageUrl), Mode=OneWay}"
                                            Visibility="{x:Bind local:ChapterButton.GetImageVisibility(ImageUrl), Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontWeight="{x:Bind local:ChapterButton.GetTitleWeight(IsPlaying), Mode=OneWay}"
                                            MaxLines="2"
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind local:ChapterButton.GetTimeText(Position), Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</local:PlayerControlBase>
