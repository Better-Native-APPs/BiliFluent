<?xml version="1.0" encoding="utf-8" ?>
<local:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Core.LiveTransportRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:live="using:BiliCopilot.UI.Live.Controls"
    xmlns:local="using:BiliCopilot.UI.Controls.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:PlayerControlBase.Resources>
        <ResourceDictionary>
            <!--  The card of the normal window: 36px round commands; play adds the button fill.  -->
            <Style
                x:Key="IslandPlayButtonStyle"
                BasedOn="{StaticResource CircleIconButtonStyle}"
                TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
            </Style>
            <Style
                x:Key="IslandIconButtonStyle"
                BasedOn="{StaticResource CircleIconButtonStyle}"
                TargetType="Button" />
            <Style
                x:Key="IslandDanmakuToggleStyle"
                BasedOn="{StaticResource DefaultToggleButtonStyle}"
                TargetType="ToggleButton">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>

            <!--  The bar of full screen and the compact window: the 52px primary play and 40px player commands.  -->
            <Style
                x:Key="OverlayPlayButtonStyle"
                BasedOn="{StaticResource PrimaryPlayerButtonStyle}"
                TargetType="Button" />
            <Style
                x:Key="OverlayIconButtonStyle"
                BasedOn="{StaticResource BasicPlayerIconButtonStyle}"
                TargetType="Button" />
            <Style
                x:Key="OverlayDanmakuToggleStyle"
                BasedOn="{StaticResource TogglePlayerIconButtonStyle}"
                TargetType="ToggleButton" />

            <Style
                x:Key="TransportButtonFlyoutPresenterStyle"
                BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="12,10" />
            </Style>
        </ResourceDictionary>
    </local:PlayerControlBase.Resources>

    <!--
        The commands of a media without a timeline, in one row. Both transport bars host it in place of their
        on-demand rows and pick the arrangement:
        - the card of the normal window: play · refresh | danmaku switch · box · send | quality · volume · compact · full screen;
        - the bar of full screen: danmaku switch · box · send | play · refresh (centred) | quality · volume · compact · full screen.
        The danmaku switch, the box and the quality entry belong to a room and leave for a media without one.
    -->
    <Grid
        x:Name="CommandRow"
        ColumnSpacing="8"
        SizeChanged="OnRowSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="Auto" />
            <ColumnDefinition x:Name="MiddleColumn" Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Play or pause, then the way back to the newest picture.  -->
        <StackPanel
            x:Name="PlaybackGroup"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Grid>
                <ProgressRing
                    x:Name="BufferingRing"
                    Width="38"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
                <Button
                    x:Name="PlayPauseButton"
                    Click="OnPlayPauseClick"
                    Style="{StaticResource IslandPlayButtonStyle}">
                    <ic:SymbolIcon
                        x:Name="PlayPauseIcon"
                        FontSize="14"
                        IconVariant="Filled"
                        Symbol="Play" />
                </Button>
            </Grid>
            <Button
                x:Name="RefreshButton"
                VerticalAlignment="Center"
                Click="OnRefreshClick"
                Style="{StaticResource IslandIconButtonStyle}">
                <ic:SymbolIcon
                    x:Name="RefreshIcon"
                    FontSize="14"
                    Symbol="ArrowSync" />
            </Button>
        </StackPanel>

        <!--  The danmaku of the room: the switch of the layer over the picture, the box and its send button.  -->
        <Grid
            x:Name="ComposerGroup"
            Grid.Column="1"
            VerticalAlignment="Center"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ComposerColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                x:Name="DanmakuToggle"
                Content="弹"
                FontSize="12"
                FontWeight="Black"
                IsChecked="{x:Bind ViewModel.Danmaku.IsShowDanmaku, Mode=TwoWay}"
                Style="{StaticResource IslandDanmakuToggleStyle}" />
            <live:LiveComposer
                x:Name="Composer"
                Grid.Column="1"
                VerticalAlignment="Center"
                Connector="{x:Bind ViewModel.LiveConnector, Mode=OneWay}"
                IsActive="False"
                Noticed="OnComposerNoticed" />
        </Grid>

        <!--  The same order in every arrangement: quality, volume, compact window, full screen.  -->
        <StackPanel
            x:Name="WindowGroup"
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <local:LiveQualityButton
                x:Name="QualityEntry"
                VerticalAlignment="Center"
                EntryStyle="{StaticResource IslandIconButtonStyle}"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            <Button
                x:Name="VolumeButton"
                VerticalAlignment="Center"
                Style="{StaticResource IslandIconButtonStyle}">
                <ic:SymbolIcon
                    x:Name="VolumeIcon"
                    FontSize="14"
                    Symbol="Speaker2" />
                <Button.Flyout>
                    <Flyout
                        x:Name="VolumeFlyout"
                        FlyoutPresenterStyle="{StaticResource TransportButtonFlyoutPresenterStyle}"
                        Opened="OnVolumeFlyoutOpened"
                        Placement="Top"
                        ShouldConstrainToRootBounds="False">
                        <StackPanel>
                            <Grid>
                                <TextBlock
                                    x:Name="VolumeCaption"
                                    HorizontalAlignment="Left"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock
                                    x:Name="VolumeText"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <Slider
                                x:Name="VolumeSlider"
                                Width="200"
                                IsThumbToolTipEnabled="True"
                                LargeChange="10"
                                Maximum="100"
                                Minimum="0"
                                SmallChange="5"
                                StepFrequency="1"
                                TickFrequency="1"
                                ValueChanged="OnVolumeChanged" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="CompactOverlayButton"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ToggleCompactOverlayCommand, Mode=OneWay}"
                Style="{StaticResource IslandIconButtonStyle}">
                <ic:SymbolIcon
                    x:Name="CompactOverlayIcon"
                    FontSize="14"
                    Symbol="ContractUpRight" />
            </Button>
            <Button
                x:Name="FullScreenButton"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ToggleFullScreenCommand, Mode=OneWay}"
                Style="{StaticResource IslandIconButtonStyle}">
                <ic:SymbolIcon
                    x:Name="FullScreenIcon"
                    FontSize="14"
                    Symbol="FullScreenMaximize" />
            </Button>
        </StackPanel>
    </Grid>
</local:PlayerControlBase>
