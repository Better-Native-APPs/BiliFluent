<?xml version="1.0" encoding="utf-8" ?>
<local:LivePartitionPageBase
    x:Class="BiliCopilot.UI.Pages.LivePartitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:livepartition="using:BiliCopilot.UI.Controls.LivePartition"
    xmlns:local="using:BiliCopilot.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind ViewModel.NavColumnWidth, Mode=OneWay, Converter={StaticResource GridLengthConverter}}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{x:Bind ViewModel.SubNavColumnWidth, Mode=OneWay, Converter={StaticResource GridLengthConverter}}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.ChildrenTransitions>
            <RepositionThemeTransition IsStaggeringEnabled="False" />
        </Grid.ChildrenTransitions>
        <Border
            Grid.Row="1"
            Grid.ColumnSpan="5"
            Height="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <TextBlock
            Margin="16,0,-6,0"
            VerticalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{ext:Locale Name=Live}"
            Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
        <TextBlock
            Grid.Column="2"
            Margin="10,0,-6,0"
            VerticalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.SelectedMainSection.Title, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsSubNavEnabled, Mode=OneWay}" />
        <livepartition:LivePartitionMainSideBody
            Grid.Row="2"
            Margin="0,0,-6,0"
            Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
        <livepartition:LivePartitionSubSideBody
            Grid.Row="2"
            Grid.Column="2"
            Margin="-6,0"
            Visibility="{x:Bind ViewModel.IsSubNavEnabled, Mode=OneWay}" />
        <livepartition:LivePartitionMainHeader Grid.Column="4" Margin="-6,0,0,0" />
        <livepartition:LiveRecommendMainBody
            Grid.Row="2"
            Grid.Column="4"
            Margin="-6,0,0,0"
            Visibility="{x:Bind ViewModel.SelectedDetail, Mode=OneWay, Converter={StaticResource ObjectToVisibilityReverseConverter}}" />
        <livepartition:LiveSubPartitionMainBody
            Grid.Row="2"
            Grid.Column="4"
            Margin="-6,0,0,0"
            ViewModel="{x:Bind ViewModel.SelectedDetail, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.SelectedDetail, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
        <!-- SelectedDetail 为空时显式隐藏子分区错误态。 -->
        <InfoBar
            Grid.Row="2"
            Grid.Column="4"
            MaxWidth="480"
            Margin="14,0,20,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.SelectedDetail.HasLoadError, Mode=OneWay, FallbackValue=False}"
            Message="{x:Bind ViewModel.SelectedDetail.LoadError, Mode=OneWay}"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.SelectedDetail.RefreshCommand, Mode=OneWay}" Content="{ext:Locale Name=Retry}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  左侧主分栏大小控制器  -->
        <Grid
            Grid.RowSpan="3"
            Grid.Column="1"
            MinWidth="6"
            controls:HoverReveal.IsHost="True">
            <Border
                Width="1"
                HorizontalAlignment="Center"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
            <community:PropertySizer
                HorizontalAlignment="Center"
                AutomationProperties.Name="{ext:Locale Name=Navigation}"
                Binding="{x:Bind ViewModel.NavColumnWidth, Mode=TwoWay}"
                IsFocusEngagementEnabled="False"
                IsTabStop="False"
                Maximum="300"
                Minimum="220"
                Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
            <Grid Visibility="{x:Bind ViewModel.IsSubNavEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                <Button
                    AutomationProperties.Name="{ext:Locale Name=HideSidePanel}"
                    Command="{x:Bind ViewModel.ToggleNavColumnCommand, Mode=OneWay}"
                    Style="{StaticResource SidePanelHideButtonStyle}"
                    ToolTipService.ToolTip="{ext:Locale Name=HideSidePanel}"
                    Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                    <ic:SymbolIcon FontSize="12" Symbol="ChevronLeft" />
                </Button>
                <Button
                    AutomationProperties.Name="{ext:Locale Name=ShowSidePanel}"
                    Command="{x:Bind ViewModel.ToggleNavColumnCommand, Mode=OneWay}"
                    Style="{StaticResource SidePanelShowButtonStyle}"
                    ToolTipService.ToolTip="{ext:Locale Name=ShowSidePanel}"
                    Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay}">
                    <ic:SymbolIcon FontSize="12" Symbol="ChevronRight" />
                </Button>
            </Grid>
        </Grid>

        <!--  左侧次分栏大小控制器  -->
        <Grid
            Grid.RowSpan="3"
            Grid.Column="3"
            MinWidth="6"
            Visibility="{x:Bind ViewModel.IsSubNavEnabled, Mode=OneWay}">
            <Border
                Width="1"
                HorizontalAlignment="Center"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
            <community:PropertySizer
                HorizontalAlignment="Center"
                AutomationProperties.Name="{ext:Locale Name=Navigation}"
                Binding="{x:Bind ViewModel.SubNavColumnWidth, Mode=TwoWay}"
                IsFocusEngagementEnabled="False"
                IsTabStop="False"
                Maximum="300"
                Minimum="180"
                Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
            <Button
                AutomationProperties.Name="{ext:Locale Name=HideSidePanel}"
                Command="{x:Bind ViewModel.ToggleNavColumnCommand, Mode=OneWay}"
                Style="{StaticResource SidePanelHideButtonStyle}"
                ToolTipService.ToolTip="{ext:Locale Name=HideSidePanel}"
                Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                <ic:SymbolIcon FontSize="12" Symbol="ChevronLeft" />
            </Button>
        </Grid>
    </Grid>
</local:LivePartitionPageBase>
