<?xml version="1.0" encoding="utf-8" ?>
<local:FollowsPageBase
    x:Class="BiliCopilot.UI.Pages.Overlay.FollowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Pages.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:users="using:BiliCopilot.UI.Controls.Users"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind ViewModel.NavColumnWidth, Mode=OneWay, Converter={StaticResource GridLengthConverter}}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.ChildrenTransitions>
            <RepositionThemeTransition IsStaggeringEnabled="False" />
        </Grid.ChildrenTransitions>
        <Border
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Height="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <TextBlock
            Margin="16,0,-6,0"
            VerticalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{ext:Locale Name=MyFollow}"
            Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
        <users:FollowsSideBody
            Grid.Row="2"
            Margin="0,0,-6,0"
            Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
        <users:FollowsMainHeader
            Grid.Column="2"
            Margin="-6,0,0,0"
            VerticalAlignment="Center" />
        <users:FollowsMainBody
            Grid.Row="2"
            Grid.Column="2"
            Margin="-6,0,0,0" />

        <!--  左侧分栏大小控制器  -->
        <Grid
            Grid.RowSpan="3"
            Grid.Column="1"
            MinWidth="6">
            <Border
                Width="1"
                HorizontalAlignment="Center"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
            <community:PropertySizer
                HorizontalAlignment="Center"
                AutomationProperties.Name="{ext:Locale Name=Navigation}"
                Binding="{x:Bind ViewModel.NavColumnWidth, Mode=TwoWay}"
                IsFocusEngagementEnabled="False"
                IsTabStop="False"
                Maximum="300"
                Minimum="220"
                Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
            <Button
                AutomationProperties.Name="{ext:Locale Name=HideSidePanel}"
                Command="{x:Bind ViewModel.ToggleNavColumnCommand, Mode=OneWay}"
                Style="{StaticResource SidePanelHideButtonStyle}"
                ToolTipService.ToolTip="{ext:Locale Name=HideSidePanel}"
                Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                <ic:SymbolIcon FontSize="12" Symbol="ChevronLeft" />
            </Button>
            <Button
                AutomationProperties.Name="{ext:Locale Name=ShowSidePanel}"
                Command="{x:Bind ViewModel.ToggleNavColumnCommand, Mode=OneWay}"
                Style="{StaticResource SidePanelShowButtonStyle}"
                ToolTipService.ToolTip="{ext:Locale Name=ShowSidePanel}"
                Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay}">
                <ic:SymbolIcon FontSize="12" Symbol="ChevronRight" />
            </Button>
        </Grid>
    </Grid>
</local:FollowsPageBase>
