<?xml version="1.0" encoding="utf-8" ?>
<local:ArticleReaderPageBase
    x:Class="BiliCopilot.UI.Pages.Overlay.ArticleReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:article="using:BiliCopilot.UI.Controls.Article"
    xmlns:comment="using:BiliCopilot.UI.Controls.Comment"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Pages.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <article:ArticleReader
            x:Name="Reader"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!--  正文加载失败、为空或无法显示时的提示. 评论与左侧工具栏仍可使用.  -->
        <StackPanel
            MaxWidth="420"
            Margin="96,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="Segoe UI Emoji"
                FontSize="40"
                Glyph="&#x1F4C4;" />
            <TextBlock
                HorizontalAlignment="Center"
                HorizontalTextAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                MaxWidth="240"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalTextAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ErrorDescription, Mode=OneWay}"
                TextWrapping="Wrap" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinWidth="96"
                    Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}"
                    Content="{ext:Locale Name=Retry}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    MinWidth="96"
                    Command="{x:Bind ViewModel.OpenInBrowserCommand, Mode=OneWay}"
                    Content="{ext:Locale Name=OpenInBrowser}"
                    Visibility="{x:Bind ViewModel.CanOpenInBrowser, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <article:ArticleReaderToolBar
            Margin="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
        <StackPanel
            x:Name="LoadingView"
            Margin="20"
            Padding="20,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <ProgressRing
                x:Name="LoadingViewRing"
                Width="20"
                Height="20"
                MinWidth="20"
                MinHeight="20"
                IsActive="False" />
            <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=LoadingAndWait}" />
        </StackPanel>
        <comment:CommentOverlayPanel IsPanelOpened="{x:Bind ViewModel.IsCommentsOpened, Mode=TwoWay}" ViewModel="{x:Bind ViewModel.CommentModule, Mode=OneWay}" />
    </Grid>
</local:ArticleReaderPageBase>
